# ─────────────────────────────────────────────────────────────────────────────
# RestoQRIS — Environment Variables Example
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env with real credentials to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=RestoQRIS
APP_ENV=development         # development | production

# ── Server Ports (host-side) ──────────────────────────────────────────────────
WEB_PORT=3000
API_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=resto
DB_PASSWORD=restopassword   # change in production
DB_NAME=resto_db
MYSQL_ROOT_PASSWORD=rootpassword  # change in production

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=             # leave blank to disable Redis auth locally
REDIS_DB=0

# ── Security ──────────────────────────────────────────────────────────────────
# IMPORTANT: Replace with a long random string in production.
JWT_SECRET=change-me-in-production

# Duration of access token (default: 15 minutes)
JWT_ACCESS_TOKEN_MINUTES=15

# Duration of refresh token (default: 30 days)
JWT_REFRESH_TOKEN_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL used by the SvelteKit app to reach the Go API.
VITE_API_BASE_URL=http://localhost:8080
